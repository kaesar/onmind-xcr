PORT=8790
XCR_STORAGE=filesystem
XCR_DATA_DIR=./xcr-data
XCR_API_KEY=
XCR_CORS_ORIGINS=*
XCR_ENV=dev
# S3 (AWS / RustFS / Floci):
# XCR_STORAGE=s3
# XCR_S3_BUCKET=xcr-registry
# XCR_S3_PREFIX=docker-registry/
# XCR_S3_ENDPOINT=http://localhost:9000
# XCR_S3_REGION=us-east-1
# XCR_S3_FORCE_PATH_STYLE=true
XCR_PRESIGNED_TTL=900
XCR_PRESIGNED_READS=true
